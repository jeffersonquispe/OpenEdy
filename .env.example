GEMINI_API_KEY=                      # LLM principal (Google AI Studio)
GEMINI_MODEL=gemini-3.6-flash        # opcional
NVIDIA_API_KEY=                      # respaldo si Gemini falla
NVIDIA_MODEL=mistralai/mistral-large-4-1t-a52b   # opcional; modelo Mistral en NVIDIA que soporte tool use
NVIDIA_REASONING_EFFORT=low          # opcional
PLATFORM_URL=http://localhost:3000   # Eduplatform (expone GET /api/courses/search)
