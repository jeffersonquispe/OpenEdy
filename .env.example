GEMINI_API_KEY=                      # LLM principal (Google AI Studio)
GEMINI_MODEL=gemini-3.6-flash        # opcional
NVIDIA_API_KEY=                      # respaldo si Gemini falla
NVIDIA_MODEL=mistralai/mistral-large-4-1t-a52b   # opcional; modelo Mistral en NVIDIA que soporte tool use
NVIDIA_REASONING_EFFORT=low          # opcional
PLATFORM_URL=http://localhost:3000   # EduTech (expone GET /api/courses/search)
LIVEKIT_URL=wss://...                # canal de voz (python -m voice.main dev --no-reload)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
ELEVENLABS_API_KEY=                 # ElevenLabs: STT y TTS
VOICE_ID=                            # voz de ElevenLabs; en plan gratis solo sirven las predeterminadas, no las de biblioteca
VOICE_MAX_SECONDS=300                # duracion maxima de cada sesion de voz
EMBED_ORIGINS=http://localhost:3000  # origenes que pueden embeber el widget, separados por coma; por defecto, PLATFORM_URL
CHAT_LIMIT_PER_MINUTE=20             # mensajes por IP
VOICE_LIMIT_PER_IP=5                 # sesiones de voz por IP en cada ventana
VOICE_LIMIT_WINDOW_SECONDS=600
VOICE_LIMIT_GLOBAL_PER_HOUR=60       # tope total de sesiones de voz nuevas
ANTHROPIC_API_KEY=                   # LLM de la voz (Claude); si falta, la voz usa Gemini
ANTHROPIC_MODEL=claude-sonnet-4-6    # opcional
